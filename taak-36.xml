<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    
    <hostname>LAB-RA04-C02-R01</hostname>

    <interface>
      <GigabitEthernet>
        <name>0/0/0.10</name>
        <description>VLAN 10 - Users network</description>
        <encapsulation>
          <dot1Q>
            <vlan-id>10</vlan-id>
          </dot1Q>
        </encapsulation>
        <ip>
          <address>
            <primary>
              <address>172.16.10.1</address>
              <mask>255.255.255.0</mask>
            </primary>
          </address>
        </ip>
      </GigabitEthernet>

      <GigabitEthernet>
        <name>0/0/0.20</name>
        <description>VLAN 20 - Servers network</description>
        <encapsulation>
          <dot1Q>
            <vlan-id>20</vlan-id>
          </dot1Q>
        </encapsulation>
        <ip>
          <address>
            <primary>
              <address>172.16.20.1</address>
              <mask>255.255.255.0</mask>
            </primary>
          </address>
        </ip>
      </GigabitEthernet>

      <GigabitEthernet>
        <name>0/0/0.30</name>
        <description>VLAN 30 - Management network</description>
        <encapsulation>
          <dot1Q>
            <vlan-id>30</vlan-id>
          </dot1Q>
        </encapsulation>
        <ip>
          <address>
            <primary>
              <address>172.16.30.1</address>
              <mask>255.255.255.0</mask>
            </primary>
          </address>
        </ip>
      </GigabitEthernet>
    </interface>

    <router>
      <ospf xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-ospf">
        <id>1</id>
        <router-id>1.1.1.1</router-id>
        <network>
          <ip>172.16.10.0</ip>
          <mask>0.0.0.255</mask>
          <area>0</area>
        </network>
        <network>
          <ip>172.16.20.0</ip>
          <mask>0.0.0.30</mask>
          <area>0</area>
        </network>
        <network>
          <ip>172.16.30.0</ip>
          <mask>0.0.0.255</mask>
          <area>0</area>
        </network>
      </ospf>
    </router>

    <banner>
      <motd>
        <banner>Welkom op LAB-RA04-C02-R01 - Toegang is beperkt tot netwerkbeheerders.</banner>
      </motd>
      <login>
        <banner>Alleen geautoriseerde gebruikers hebben toegang. Verbreek de verbinding indien u geen toestemming heeft.</banner>
      </login>
    </banner>

  </native>
</config>
